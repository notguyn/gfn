{
	"$schema": "https://biomejs.dev/schemas/1.8.3/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey":"info"
			},
			"complexity": {
				"noForEach": "off"
			},
			"correctness": {
				"noUnusedImports":"error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"lineEnding":"lf"
	}
}
